{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RSX",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#tags"
    },
    {
      "include": "#strings"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rsx",
          "match": "//.*$"
        },
        {
          "name": "comment.block.rsx",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "tags": {
      "patterns": [
        {
          "name": "tag.open.rsx",
          "match": "(<)([a-zA-Z0-9_-]+)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.rsx" },
            "2": { "name": "entity.name.tag.rsx" }
          }
        },
        {
          "name": "tag.close.rsx",
          "match": "(</)([a-zA-Z0-9_-]+)(>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.begin.rsx" },
            "2": { "name": "entity.name.tag.rsx" },
            "3": { "name": "punctuation.definition.tag.end.rsx" }
          }
        },
        {
          "name": "tag.self-closing.rsx",
          "match": "(/>)",
          "captures": {
            "1": { "name": "punctuation.definition.tag.end.rsx" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.rsx",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.rsx",
              "match": "\\\\."
            }
          ]
        }
      ]
    }
  },
  "scopeName": "source.rsx"
}
