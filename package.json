{
  "name": "strata-vscode",
  "displayName": "Strata & RSX Language Support",
  "description": "Language Server Protocol (LSP), tree-sitter grammars, syntax highlighting, and editor tooling for Strata & RSX",
  "version": "0.1.0",
  "publisher": "strataui",
  "repository": {
    "type": "git",
    "url": "https://github.com/strataui/vscode"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "rust",
    "strata",
    "rsx",
    "tailwind",
    "lsp"
  ],
  "main": "./client/out/extension.js",
  "activationEvents": [
    "onLanguage:rsx",
    "onLanguage:rust"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./client/tsconfig.json",
    "watch": "tsc -w -p ./client/tsconfig.json",
    "build": "npm run compile"
  },
  "contributes": {
    "languages": [
      {
        "id": "rsx",
        "aliases": [
          "RSX",
          "rsx"
        ],
        "extensions": [
          ".rsx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rsx",
        "scopeName": "source.rsx",
        "path": "./syntaxes/rsx.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "strata.restartServer",
        "title": "Strata: Restart Language Server",
        "category": "Strata"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Strata",
      "properties": {
        "strata.lsp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the strata-lsp executable binary. If omitted, the extension searches PATH and workspace target directories."
        },
        "strata.lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the Strata language server."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.82.0",
    "typescript": "^5.3.3"
  }
}
